classDiagram
    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet)
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task)
    }

    class Task {
        +str description
        +str category
        +datetime time
        +int duration_minutes
        +str priority
        +str frequency
        +bool completed
        +mark_complete()
    }
    
    class Scheduler {
        +Owner owner
        +get_todays_tasks(today) list~Task~
        +sort_by_time(tasks) list~Task~
        +find_conflicts() list~tuple~
    }
    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : manages

