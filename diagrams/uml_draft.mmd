classDiagram
    class Owner {
        +name
        +pets
        +add_pet()
        +get_all_tasks()
    }

    class Pet {
        +name
        +species
        +age
        +tasks
        +add_task()
    }

    class Task {
        +description
        +category
        +time
        +duration_minutes
        +priority
        +frequency
        +completed
        +mark_complete()
    }

    class Scheduler {
        +owner
        +get_todays_tasks()
        +sort_by_time()
        +find_conflicts()
    }

    Owner "1" --> "many" Pet : has
    Pet "1" --> "many" Task : has
    Scheduler "1" --> "1" Owner : manages
